# Signs the session cookie. Required in production: openssl rand -base64 32
SESSION_SECRET=

# Optional. Leave empty to use the built-in, auto-seeded PGlite (Postgres in WebAssembly).
# Set to a Postgres URL (Neon, Supabase, RDS…) to use a real database.
DATABASE_URL=

# Optional. Enables subdomain routing, e.g. nakhla.sahm.example → /s/nakhla
ROOT_DOMAIN=
